@* Общий шаблон используется другими Razor-страницами; данные передаются из вызывающего представления или контроллера. *@
@using Cinema.Data
@using Microsoft.EntityFrameworkCore
@inject CinemaDbContext SiteDb
@{
    var settings = await SiteDb.SiteSettings.AsNoTracking().ToDictionaryAsync(x => x.Key, x => x.Value);
    var siteName = settings.GetValueOrDefault("Name", "Кинотеатр им. Павлюка");
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · @siteName</title>
    <meta name="description" content="Кинотеатр: афиша, расписание, выбор мест и электронные билеты." />
    <link rel="icon" href="~/images/icon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/lib/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/reference.css" asp-append-version="true" />
</head>
<body>
<a class="skip-link" href="#main">Перейти к содержимому</a>
<header class="site-header reference-header">
    <div class="header-inner">
        <a class="reference-logo" asp-area="" asp-controller="Home" asp-action="Index" aria-label="На главную">
            <img class="desktop-logo" src="~/images/pavlyuk-logo.svg" alt="Кинотеатр им. Павлюка" width="190" height="64" />
            <img class="mobile-logo" src="~/images/pavlyuk-logo.svg" alt="Кинотеатр им. Павлюка" width="155" height="48" />
        </a>
        <a class="refund-link" asp-area="" asp-controller="Home" asp-action="Returns"><img src="~/images/reference/Refund-24.svg" alt="" width="20" height="20" /> Возврат билетов</a>
        <nav id="main-nav" aria-label="Основная навигация">
            <a asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="schedule">Расписание</a>
            <a asp-area="" asp-controller="Movies" asp-action="Index">Афиша</a>
            <details class="nav-dropdown"><summary>О нас</summary><div>
                <a asp-area="" asp-controller="Home" asp-action="About">О киноцентре</a>
                <a asp-area="" asp-controller="Home" asp-action="Services">Услуги</a>
                <a asp-area="" asp-controller="Reviews" asp-action="Index">Отзывы</a>
                <a asp-area="" asp-controller="Home" asp-action="News">Новости и акции</a>
                <a asp-area="" asp-controller="Home" asp-action="Contacts">Контакты</a>
                <a asp-area="" asp-controller="Home" asp-action="Team">Команда проекта</a>
            </div></details>
            <details class="nav-dropdown"><summary>Помощь</summary><div>
                <a asp-area="" asp-controller="Home" asp-action="Contacts">Служба поддержки</a>
                <a asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="faq">Частые вопросы</a>
                <a asp-area="" asp-controller="Home" asp-action="Returns">Возврат билетов</a>
                <a asp-area="" asp-controller="Booking" asp-action="Index">Бронирование билетов</a>
            </div></details>
        </nav>
        <a class="header-search" asp-area="" asp-controller="Movies" asp-action="Index" aria-label="Поиск фильма"><img src="~/images/reference/Search-16.svg" alt="" width="20" height="20" /></a>
        <a class="account-link" asp-area="" asp-controller="Account" asp-action="Index">@(User.Identity?.IsAuthenticated == true ? "Личный кабинет" : "Войти")</a>
        <button type="button" class="menu-toggle" aria-label="Меню" aria-controls="main-nav" aria-expanded="false"><img src="~/images/reference/MenuMobile-32.svg" alt="" width="32" height="32" /></button>
    </div>
</header>
<main id="main">
    @if (TempData["Success"] is string success) { <div class="shell"><div class="notice success" role="status">@success</div></div> }
    @if (TempData["Error"] is string error) { <div class="shell"><div class="notice error" role="alert">@error</div></div> }
    @RenderBody()
</main>
<footer class="reference-footer">
    <div class="shell footer-main">
        <div><a asp-area="" asp-controller="Home" asp-action="Index"><img class="footer-logo" src="~/images/pavlyuk-logo.svg" alt="Кинотеатр им. Павлюка" width="160" height="64" /></a></div>
        <div class="footer-address"><p>@settings.GetValueOrDefault("Address")</p><p>тел.: @settings.GetValueOrDefault("Phone")</p><p>@settings.GetValueOrDefault("Email")</p><small>@settings.GetValueOrDefault("Hours")</small></div>
        <nav aria-label="Ссылки в подвале"><a asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="schedule">Расписание</a><a asp-area="" asp-controller="Movies" asp-action="Index">Скоро в кино</a><a asp-area="" asp-controller="Home" asp-action="Services">Услуги</a><a asp-area="" asp-controller="Home" asp-action="News">Новости и акции</a><a asp-area="" asp-controller="Home" asp-action="Contacts">Служба поддержки</a></nav>
        <div class="footer-social"><a href="@settings.GetValueOrDefault("SocialVk", "https://vk.com")" target="_blank" rel="noopener" aria-label="ВКонтакте">vk</a><a href="@settings.GetValueOrDefault("SocialTelegram", "https://t.me")" target="_blank" rel="noopener" aria-label="Телеграм">➤</a><a asp-area="" asp-controller="Account" asp-action="Orders" aria-label="Личный кабинет">◉</a></div>
    </div>
    <div class="shell footer-payments"><img src="~/images/reference/visa.svg" alt="Visa" /><img src="~/images/reference/mastercard.svg" alt="Mastercard" /><img src="~/images/reference/mir.svg" alt="Мир" /></div>
    <div class="shell footer-bottom"><span>© @DateTime.UtcNow.Year · @siteName</span><a asp-area="" asp-controller="Home" asp-action="Legal">Правовая информация</a><a asp-area="" asp-controller="Home" asp-action="Team">Команда и распределение задач</a></div>
</footer>
<script src="~/lib/bootstrap/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
