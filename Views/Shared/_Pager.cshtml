@* Общий шаблон используется другими Razor-страницами; данные передаются из вызывающего представления или контроллера. *@
@{
    int currentPage = ViewBag.Page ?? 1; bool next = ViewBag.HasNext ?? false;
    // Replace an existing page parameter instead of appending duplicate values.
    var query = Context.Request.Query.Where(x => x.Key != "page").ToDictionary(x => x.Key, x => x.Value.ToString());
    query["page"] = (currentPage - 1).ToString(); var prevUrl = Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(Context.Request.Path, query!);
    query["page"] = (currentPage + 1).ToString(); var nextUrl = Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(Context.Request.Path, query!);
}
@if (currentPage > 1 || next) { <nav class="pager" aria-label="Страницы">@if (currentPage > 1) { <a class="btn btn-outline" href="@prevUrl">← Назад</a> }<span>Страница @currentPage</span>@if (next) { <a class="btn btn-outline" href="@nextUrl">Далее →</a> }</nav> }
