@* Общий шаблон используется другими Razor-страницами; данные передаются из вызывающего представления или контроллера. *@
@* Тип данных, переданных контроллером при вызове View(...), указан после @model. *@
@model ScheduleCardModel
<article class="reference-movie-row" data-film-title="@Model.Movie.Title.ToLowerInvariant()">
    <a class="reference-movie-poster" asp-controller="Movies" asp-action="Details" asp-route-id="@Model.Movie.Id"><img src="@Model.Movie.PosterPath" alt="@Model.Movie.Title" loading="lazy" width="280" height="400" />@if (Model.Movie.IsFeatured) { <span class="memorandum">Меморандум</span> }</a>
    <div class="reference-movie-info"><span class="movie-country">@Model.Movie.Country</span><h2><a asp-controller="Movies" asp-action="Details" asp-route-id="@Model.Movie.Id">@Model.Movie.Title</a></h2><div class="reference-film-meta"><span class="age-badge">@Model.Movie.AgeRating+</span><span>@(Model.Movie.DurationMinutes / 60) ч @(Model.Movie.DurationMinutes % 60) мин</span></div><p class="reference-genre">@Model.Movie.Genre</p><div class="reference-time-grid">@foreach (var session in Model.Sessions) { <a class="reference-time" asp-controller="Booking" asp-action="Seats" asp-route-id="@session.Id"><strong>@session.StartsAt.ToString("HH:mm")</strong><span>@session.Hall.Name</span><small>@session.Price.ToString("0") руб.</small><b>2D</b></a> }</div><a class="film-details-link" asp-controller="Movies" asp-action="Details" asp-route-id="@Model.Movie.Id">Подробнее о фильме →</a></div>
</article>
