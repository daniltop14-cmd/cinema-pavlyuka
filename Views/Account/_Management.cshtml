@if (User.IsInRole("Admin") || User.IsInRole("Manager"))
{
<section class="panel account-management" aria-labelledby="management-title">
<div class="eyebrow">@(User.IsInRole("Admin") ? "АДМИНИСТРАТОР" : "МЕНЕДЖЕР")</div>
<h2 id="management-title">Управление кинотеатром</h2>
<p>Выберите раздел для управления.</p>
<nav class="account-management-links" aria-label="Разделы управления кинотеатром">
<a class="btn btn-outline" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Обзор</a>
<a class="btn btn-outline" asp-area="Admin" asp-controller="Bookings" asp-action="Index">Заказы и оплаты</a>
<a class="btn btn-outline" asp-area="Admin" asp-controller="Reviews" asp-action="Index">Отзывы и обращения</a>
@if (User.IsInRole("Admin"))
{
<a class="btn btn-outline" asp-area="Admin" asp-controller="Movies" asp-action="Index">Фильмы</a>
<a class="btn btn-outline" asp-area="Admin" asp-controller="Sessions" asp-action="Index">Сеансы</a>
<a class="btn btn-outline" asp-area="Admin" asp-controller="Halls" asp-action="Index">Кинозалы и места</a>
<a class="btn btn-outline" asp-area="Admin" asp-controller="Users" asp-action="Index">Пользователи</a>
<a class="btn btn-outline" asp-area="Admin" asp-controller="Content" asp-action="Index">Услуги</a>
<a class="btn btn-outline" asp-area="Admin" asp-controller="Content" asp-action="Index" asp-route-kind="faq">Вопросы и ответы</a>
<a class="btn btn-outline" asp-area="Admin" asp-controller="Content" asp-action="Settings">Оформление и контакты</a>
}
</nav>
</section>
}
