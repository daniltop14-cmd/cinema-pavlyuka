@* Разметка и данные раздела Views → Account → Password.cshtml. Пояснения размещены непосредственно перед соответствующими блоками. *@
@* Эта страница получает из контроллера модель указанного типа. *@
@model PasswordModel
@* Подготавливаем данные или заголовок для этой Razor-страницы. *@
@{ ViewData["Title"] = "Смена пароля"; }
@* Создаём смысловой блок страницы для разметки и стилей. *@
<section class="shell page-section">
@* Заголовок задаёт тему блока на странице. *@
<h1>Изменить пароль</h1>
@* Показываем текстовое значение или пояснение пользователю. *@
<partial name="_AccountNav" />
@* Форма отправляет введённые данные в указанное действие контроллера. *@
<form asp-action="Password" method="post" class="panel form-panel readable">
@* Группируем элементы для оформления и расположения. *@
<div asp-validation-summary="All" class="validation">
</div>
<label asp-for="CurrentPassword">Текущий пароль</label>
@* Поле формы получает и отправляет значение модели. *@
<input asp-for="CurrentPassword" required autocomplete="current-password" />
<label asp-for="NewPassword">Новый пароль</label>
@* Поле формы получает и отправляет значение модели. *@
<input asp-for="NewPassword" required minlength="8" autocomplete="new-password" />
<label asp-for="ConfirmPassword">Повторите новый пароль</label>
@* Поле формы получает и отправляет значение модели. *@
<input asp-for="ConfirmPassword" required autocomplete="new-password" />
@* Кнопка запускает действие формы или браузерного скрипта. *@
<button class="btn">Изменить пароль</button>
</form>
</section>
