@* Данные для этой страницы готовит Controllers/AccountController.cs; Razor получает их через @model или ViewData. *@
@* Тип данных, переданных контроллером при вызове View(...), указан после @model. *@
@model List<Booking>
@{ ViewData["Title"] = "Мой кабинет"; }
<section class="shell page-section">
<div class="eyebrow">ВАШЕ ЛИЧНОЕ ПРОСТРАНСТВО</div>
<h1>Мой кабинет<span class="red">.</span>
</h1>
@* Вставляем общий фрагмент _AccountNav и передаём ему указанную модель. *@
<partial name="_AccountNav" />
@* Вставляем общий фрагмент _Management и передаём ему указанную модель. *@
<partial name="_Management" />@if (Model.Count == 0) { <div class="panel empty">
<h2>Впереди много хороших историй</h2>
<p>В этом разделе пока нет заказов.</p>
<a class="btn" asp-controller="Movies" asp-action="Index">Выбрать фильм ↗</a>
</div> }@foreach (var booking in Model) { <article class="panel order-card">
<img src="@booking.Session.Movie.PosterPath" alt="@booking.Session.Movie.Title" loading="lazy" />
<div>
<span class="eyebrow">ЗАКАЗ № @booking.Id</span>
<h2>@booking.Session.Movie.Title</h2>
<p>@booking.Session.StartsAt.ToString("dd MMMM yyyy, HH:mm") · @booking.Session.Hall.Name</p>
<p class="muted">@string.Join("; ", booking.BookingSeats.Select(x => $"ряд {x.Seat.Row}, место {x.Seat.Number}"))</p>
<span class="status @booking.Status.ToString().ToLowerInvariant()">@Labels.Status(booking.Status)</span>
</div>
<div class="order-actions">
<strong>@booking.Total.ToString("0") ₽</strong>@if (booking.Status == BookingStatus.Paid) { <a class="btn" asp-controller="Booking" asp-action="Ticket" asp-route-id="@booking.Id">Открыть билеты</a> }@if (booking.Status == BookingStatus.Pending) { <a class="btn" asp-controller="Booking" asp-action="Checkout" asp-route-id="@booking.Id">Оплатить</a>
@* Поля формы отправляются методом POST в действие Cancel контроллера; сервер повторно проверяет данные. *@
<form asp-controller="Booking" asp-action="Cancel" method="post">
<input type="hidden" name="id" value="@booking.Id" />
<button class="btn btn-outline">Отменить бронь</button>
</form> }</div>
</article> }<partial name="_Pager" />
</section>
