@model Booking
@inject CinemaClock Clock
@{ ViewData["Title"] = "Оплата заказа"; }
<section class="shell page-section readable">
<div class="eyebrow">02 / ОПЛАТА</div>
<h1>Почти в кино<span class="red">.</span>
</h1>
<div class="panel">
<h2>@Model.Session.Movie.Title</h2>
<p>@Model.Session.StartsAt.ToString("dd MMMM yyyy, HH:mm") · @Model.Session.Hall.Name</p>
<p>@string.Join(" · ", Model.BookingSeats.Select(x => $"Ряд {x.Seat.Row}, место {x.Seat.Number}"))</p>
<p>Заказ № @Model.Id · @Labels.Status(Model.Status)</p>
<div class="summary-total">
<span>К оплате</span>
<strong>@Model.Total.ToString("0.00") ₽</strong>
</div>
@if (Model.Status == BookingStatus.Pending) { <div class="notice" data-countdown="@Model.ExpiresAtUtc.ToString("yyyy-MM-ddTHH:mm:ssZ")">Бронь до @Clock.Local(Model.ExpiresAtUtc).ToString("HH:mm:ss"). Осталось: <strong id="countdown">—</strong>
</div>

<form asp-action="Pay" method="post">
<input type="hidden" name="id" value="@Model.Id" />
<button class="btn full-width" id="pay-button">Подтвердить оплату ↗</button>
</form>
<form asp-action="Cancel" method="post" class="mt-3">
<input type="hidden" name="id" value="@Model.Id" />
<button class="btn btn-outline full-width">Отменить бронь</button>
</form> }
else if (Model.Status == BookingStatus.Paid) { <a class="btn" asp-action="Ticket" asp-route-id="@Model.Id">Открыть электронный билет ↗</a> }
else { <p>Эта бронь больше не действует. Выберите места заново.</p>
<a class="btn" asp-controller="Movies" asp-action="Index">Вернуться к афише</a> }</div>
</section>
