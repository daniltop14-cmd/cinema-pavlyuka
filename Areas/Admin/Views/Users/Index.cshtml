@* Данные для раздела Users готовит Areas/Admin/Controllers/UsersController.cs; Razor выводит их в HTML. *@
@* Тип данных, переданных контроллером при вызове View(...), указан после @model. *@
@model List<ApplicationUser>
@{ ViewData["Title"] = "Пользователи"; var roles = (Dictionary<string, IList<string>>)ViewBag.Roles; }
<h1>Пользователи</h1>
@* Поля формы отправляются методом GET в действие действие, указанное формой контроллера; сервер повторно проверяет данные. *@
<form method="get" class="filter-bar">
<div>
<label for="search">Имя или email</label>
<input id="search" name="search" value="@ViewBag.Search" />
</div>
<button class="btn">Найти</button>
</form>
<div class="table-wrap">
<table>
<thead>
<tr>
<th>Имя</th>
<th>Email</th>
<th>Роль</th>
<th>Доступ</th>
</tr>
</thead>
<tbody>@foreach (var item in Model) { var blocked = item.LockoutEnd > DateTimeOffset.UtcNow; <tr>
<td>@item.DisplayName</td>
<td>@item.Email</td>
<td>
@* Поля формы отправляются методом POST в действие Role контроллера; сервер повторно проверяет данные. *@
<form asp-action="Role" method="post" class="inline-form">
<input type="hidden" name="id" value="@item.Id" />
<select name="role" aria-label="Роль @item.DisplayName">@foreach (var role in new[] { "User", "Manager", "Admin" }) { <option value="@role" selected="@roles[item.Id].Contains(role)">@Labels.Role(role)</option> }</select>
<button class="btn btn-small">Сохранить</button>
</form>
</td>
<td>
@* Поля формы отправляются методом POST в действие Block контроллера; сервер повторно проверяет данные. *@
<form asp-action="Block" method="post">
<input type="hidden" name="id" value="@item.Id" />
<input type="hidden" name="blocked" value="@(!blocked ? "true" : "false")" />
<button class="link-button">@(blocked ? "Разблокировать" : "Заблокировать")</button>
</form>
</td>
</tr> }</tbody>
</table>
</div>
@* Вставляем общий фрагмент _Pager и передаём ему указанную модель. *@
<partial name="_Pager" />
