@* Общий HTML-каркас админки: меню, заголовок и область RenderBody для содержимого каждой страницы. *@
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>@ViewData["Title"] · Управление кинотеатром</title>
<link rel="stylesheet" href="~/lib/bootstrap/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/fonts.css" /><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/reference.css" asp-append-version="true" />
</head>
<body class="admin-body">
<a class="skip-link" href="#main">Перейти к содержимому</a>
<div class="admin-layout">
<aside class="admin-sidebar">
<a class="brand" asp-area="" asp-controller="Home" asp-action="Index"><img src="~/images/pavlyuk-logo.svg" alt="Кинотеатр им. Павлюка" width="180" height="60" /></a>
<small>ПАНЕЛЬ УПРАВЛЕНИЯ</small>
<nav aria-label="Управление">
<a asp-controller="Dashboard" asp-action="Index">Обзор</a>
<a asp-controller="Bookings" asp-action="Index">Заказы и оплаты</a>
<a asp-controller="Reviews" asp-action="Index">Отзывы</a>@if (User.IsInRole("Admin")) { <a asp-controller="Movies" asp-action="Index">Фильмы</a>
<a asp-controller="Sessions" asp-action="Index">Сеансы</a>
<a asp-controller="Halls" asp-action="Index">Кинозалы</a>
<a asp-controller="Users" asp-action="Index">Пользователи</a>
<a asp-controller="Content" asp-action="Index" asp-route-kind="services">Услуги</a>
<a asp-controller="Content" asp-action="Index" asp-route-kind="faq">Вопросы и ответы</a>
<a asp-controller="Content" asp-action="Index" asp-route-kind="team">Команда</a>
<a asp-controller="Content" asp-action="Messages">Обращения</a>
<a asp-controller="Content" asp-action="Settings">Главная и контакты</a> }</nav>
<a asp-area="" asp-controller="Account" asp-action="Orders">← Личный кабинет</a>
@* Поля формы отправляются методом POST в действие Logout контроллера; сервер повторно проверяет данные. *@
<form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
<button class="link-button">Выйти</button>
</form>
</aside>
<main id="main" class="admin-main">
<div class="admin-top">
<span>@(User.IsInRole("Admin") ? "Администратор" : "Менеджер")</span>
<a asp-area="" asp-controller="Home" asp-action="Index">Открыть сайт ↗</a>
</div>@if (TempData["Success"] is string success) { <div class="notice success" role="status">@success</div> }@if (TempData["Error"] is string error) { <div class="notice error" role="alert">@error</div> }@RenderBody()</main>
</div>
<script src="~/js/site.js" asp-append-version="true">
</script>@await RenderSectionAsync("Scripts", required: false)</body>
</html>
