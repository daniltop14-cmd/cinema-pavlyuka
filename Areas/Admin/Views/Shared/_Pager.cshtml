@* Разметка и данные раздела Areas → Admin → Views → Shared → _Pager.cshtml. Пояснения размещены непосредственно перед соответствующими блоками. *@
@* Подготавливаем данные или заголовок для этой Razor-страницы. *@
@{ int currentPage = ViewBag.Page ?? 1; bool next = ViewBag.HasNext ?? false; var query = Context.Request.Query.Where(x => x.Key != "page").ToDictionary(x => x.Key, x => x.Value.ToString()); query["page"] = (currentPage - 1).ToString(); var prev = Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(Context.Request.Path, query!); query["page"] = (currentPage + 1).ToString(); var following = Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(Context.Request.Path, query!); }
@* Показываем следующий блок только при выполнении условия. *@
@if (currentPage > 1 || next) { <nav class="pager">@if (currentPage > 1) { <a class="btn btn-outline" href="@prev">← Назад</a> }<span>Страница @currentPage</span>@if (next) { <a class="btn btn-outline" href="@following">Далее →</a> }</nav> }
