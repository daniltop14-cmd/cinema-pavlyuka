@model List<Booking>
@{ ViewData["Title"] = "Заказы и оплаты"; }
<h1>Заказы и оплаты</h1>
<form method="get" class="filter-bar">
<div>
<label for="search">Номер, email или фильм</label>
<input name="search" id="search" value="@ViewBag.Search" />
</div>
<div>
<label for="status">Статус</label>
<select name="status" id="status">
<option value="">Все</option>@foreach (var status in Enum.GetValues<BookingStatus>()) { <option value="@status" selected="@(ViewBag.Status != null && (BookingStatus)ViewBag.Status == status)">@Labels.Status(status)</option> }</select>
</div>
<button class="btn">Найти</button>
</form>
<div class="table-wrap">
<table>
<thead>
<tr>
<th>Заказ / пользователь</th>
<th>Фильм / сеанс</th>
<th>Зал и места</th>
<th>Сумма</th>
<th>Оплата</th>
<th>Бронь</th>
<th>Действия</th>
</tr>
</thead>
<tbody>@foreach (var item in Model) { <tr>
<td>№ @item.Id<br />
<small>@item.User.Email</small>
</td>
<td>@item.Session.Movie.Title<br />
<small>@item.Session.StartsAt.ToString("dd.MM HH:mm")</small>
</td>
<td>@item.Session.Hall.Name<br />
<small>@string.Join("; ", item.BookingSeats.Select(x => $"{x.Seat.Row} ряд / {x.Seat.Number}"))</small>
</td>
<td>@item.Total.ToString("0") ₽</td>
<td>@(item.Payment == null ? "Не оплачено" : item.Payment.IsRefunded ? "Возврат" : "Оплата")</td>
<td>
<span class="status">@Labels.Status(item.Status)</span>
</td>
<td>@if (item.Status == BookingStatus.Pending) { <form asp-action="Confirm" method="post" data-confirm="Подтвердить оплату заказа?">
<input name="id" value="@item.Id" type="hidden" />
<button class="link-button">Подтвердить</button>
</form>
<form asp-action="Cancel" method="post">
<input name="id" value="@item.Id" type="hidden" />
<button class="link-button danger">Отменить</button>
</form> }@if (item.Status == BookingStatus.Paid) { <form asp-action="Cancel" method="post" data-confirm="Выполнить возврат и освободить места?">
<input name="id" value="@item.Id" type="hidden" />
<input name="refund" value="true" type="hidden" />
<button class="link-button danger">Возврат</button>
</form> }</td>
</tr> }</tbody>
</table>
</div>
<partial name="_Pager" />
