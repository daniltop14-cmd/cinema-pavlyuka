@* Данные для раздела Movies готовит Areas/Admin/Controllers/MoviesController.cs; Razor выводит их в HTML. *@
@* Тип данных, переданных контроллером при вызове View(...), указан после @model. *@
@model List<Movie>
@{ ViewData["Title"] = "Фильмы"; }
<div class="section-head">
<h1>Фильмы</h1>
<a class="btn" asp-action="Edit">Добавить фильм +</a>
</div>
<div class="table-wrap">
<table>
<thead>
<tr>
<th>Фильм</th>
<th>Жанр</th>
<th>Минут</th>
<th>Возраст</th>
<th>Действия</th>
</tr>
</thead>
<tbody>@foreach (var item in Model) { <tr>
<td>@item.Title</td>
<td>@item.Genre</td>
<td>@item.DurationMinutes</td>
<td>@item.AgeRating+</td>
<td class="table-actions">
<a asp-action="Edit" asp-route-id="@item.Id">Изменить</a>
@* Поля формы отправляются методом POST в действие Delete контроллера; сервер повторно проверяет данные. *@
<form asp-action="Delete" method="post" data-confirm="Удалить фильм?">
<input type="hidden" name="id" value="@item.Id" />
<button class="link-button danger">Удалить</button>
</form>
</td>
</tr> }</tbody>
</table>
</div>
@* Вставляем общий фрагмент _Pager и передаём ему указанную модель. *@
<partial name="_Pager" />
